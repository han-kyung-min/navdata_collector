<!---->
<launch>
  <arg name="map_file_name" default=""/>

  <!-- deterministic restart pose (map frame) -->
  <arg name="start_x" default="0.0"/>
  <arg name="start_y" default="0.0"/>
  <arg name="start_yaw" default="0.0"/>

  <!-- start sync SLAM (lifelong) -->
  <node pkg="slam_toolbox"
        type="sync_slam_toolbox_node"
        name="slam_toolbox"
        output="screen">

    <!-- If your scan topic is NOT /scan, uncomment and fix it -->
    <!-- <remap from="scan" to="/base_scan"/> -->

    <rosparam command="load"
              file="$(find slam_toolbox)/config/mapper_params_lifelong.yaml" />

    <!-- Keep for bookkeeping (but deserialize_map still required) -->
    <param name="map_file_name" value="$(arg map_file_name)" />

    <!-- Start from a known “dock/start” -->
    <param name="map_start_at_dock" value="true" type="bool"/>

    <!-- Force the restart pose (so every reboot aligns the same way) -->
    <rosparam param="map_start_pose">[$(arg start_x), $(arg start_y), $(arg start_yaw)]</rosparam>

  </node>
</launch>
