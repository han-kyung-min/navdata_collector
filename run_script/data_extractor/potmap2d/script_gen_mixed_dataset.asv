    display(data_cnt) ;
    data_cnt = data_cnt + 1;
end

% do noncolldata
data_cnt = length(colldata_list) ;
num_noncolldata = num_colldata ;
for idx=1:num_noncolldata
    src_path = sprintf('%s/%s', noncolldata_folder, noncolldata_list(idx) ) ;
