% test noncolldata

for idx=num_noncolldata-500:num_noncolldata
    src_path = sprintf('%s/%s', noncolldata_folder, noncolldata_list(idx) ) ;
    tgt_path = sprintf('%s/data%05d', mixed_8K_paths, data_cnt ) ;
    cmd = sprintf('cp -rf %s %s', src_path, tgt_path)  ;
    system(cmd) ;
    display(data_cnt) ;
    data_cnt = data_cnt + 1;
end




