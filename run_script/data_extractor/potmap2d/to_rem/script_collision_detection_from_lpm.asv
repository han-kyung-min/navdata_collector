
base_dir = fileparts( fileparts( fileparts(pwd) ) ) ;
config_file = sprintf('%s/param/navdata_collector.yaml',base_dir);
config = ReadYaml(config_file) ;
inpath = config.navdata_extractor.inpath ;

sync_metadata_dir = '/media/results/navdata_collector/collision_data/processed/2025-07-13-17-41/bag_2025-07-13-17-41-23/synced' ;

eta = 1.0 ;             % Repulsive potential scaling factor (η)
rho0 = 1.2 / 0.05 ;     % Influence distance (ρ0, # grids )
obs_thr = 99 ;

cm_params.resolution = 0.05 ;
cm_params.map_size_m = 10.0 ;
cm_params.robot_radius_m = 0.25 ;
cm_params.inflation_radius_m = 1.0 ;
cm_params.max_range_m = 25;

% robot pose 
odom = load(sprintf("%s/sync_odom.txt", sync_metadata_dir)) ;
[num_data, c] = size(odom) ;
px = odom(:,5) ;
py = odom(:,6) ;
px_min = min(px) ;
px_max = max(px) ;
py_min = min(py) ;
py_max = max(py) ;

% load waypoints
waypoints = load(sprintf('%s/sync_waypoints.txt', sync_metadata_dir)) ;

%% === Step 2: Compute ρ(q) = distance to the nearest obstacle ===
% bwdist() returns the Euclidean distance in pixels from each free cell
% to the nearest obstacle cell.

% load subgoal
subgoals = load(sprintf('%s/sync_rel_subgoals.txt', sync_metadata_dir)) ;

%2025-07-13-17-41/bag_2025-07-13-17-41-23
%[2500~2560, 2672~2680, 2839~2850, 2937~2957]

for data_idx = 2672:num_data

    % === Construct file paths ==
    data_idx 
    rgb_img = imread(sprintf('%s/rgb%05d.png', sync_metadata_dir, data_idx )) ;

    waypt_line = waypoints(data_idx,:) ;
    joy_on = waypt_line(5);
    waypt_traj_px = reshape( waypt_line([8,9, 12,13, 16,17, 20, 21, 24,25]), 2, 5)' / resolution ; 
    tgt_wx_px = waypt_traj_px(2,1) ; % 2nd wpt
    tgt_wy_px = waypt_traj_px(2,2)  ; % 
    attr_ang_rad = atan2(tgt_wy_px, tgt_wx_px) ;

    scandata = load(sprintf('%s/scan%05d.txt', sync_metadata_dir, data_idx-1) ) ;
    ranges = scandata(:,2) ;
    angles = scandata(:,1) ;

    %sg
    sg_px = subgoals(data_idx,5:6) / resolution ;

    % build costmap
    [costmap_i8, costmap_u8] = build_costmap( ranges, angles, cm_params) ;

    ukn_idx = find(costmap_i8 == -1) ;

    obstacle_mask = costmap_i8 >= obs_thr;
    rho = bwdist(obstacle_mask) ; %resolution;  % ρ(q) in meters
    
    %% === Step 3: Compute Repulsive Potential U_rel(q) ===
    % U_rep(q) = 0.5 * η * (1/ρ(q) - 1/ρ0)^2 if ρ(q) <= ρ0, else 0.
    Urep = zeros(size(rho));
    mask = (rho <= rho0) & (rho > 0);  % Valid region of influence
    Urep(mask) = 0.5 * eta * (1 ./ rho(mask) - 1/rho0).^2;
    
    %% === Step 4: Compute the Gradient of ρ(q) (for force direction) ===
    % ∇ρ(q) points outward from obstacles. Normalize it to get direction.
    [dRhoX, dRhoY] = gradient(rho, 1);  % Derivatives of ρ(q)
    grad_norm = sqrt(dRhoX.^2 + dRhoY.^2) + 1e-8;
    dir_x = dRhoX ./ grad_norm;   % Unit vector in x-direction
    dir_y = dRhoY ./ grad_norm;   % Unit vector in y-direction
    
    %% === Step 5: Compute Repulsive Force Field F_rel(q) ===
    % F_rel(q) = η * (1/ρ(q) - 1/ρ0) * (1/ρ(q)^2) * ∇ρ(q)
    Frx = zeros(size(rho));
    Fry = zeros(size(rho));
    Fr_magnitude = eta * (1 ./ rho(mask) - 1/rho0) ./ (rho(mask).^2);
    Frx(mask) = Fr_magnitude .* dir_x(mask);
    Fry(mask) = Fr_magnitude .* dir_y(mask);
    
    angle_map = rad2deg(atan2(Fry, Frx)) ;
    %angle_map(ukn_idx) = 0;
    % draw_forcemap(costmap_i8, angle_map, map_size) ;
    
    [costmap_roi, angle_map_roi, roi_front_px, roi_back_px] = set_roi(costmap_i8,  angle_map, cm_params) ;
    
    % roi flow
    val_roi_idx = find(costmap_roi >= 0) ;
    med_rep_flow_deg = median( angle_map_roi(val_roi_idx) ) ;
    med_rep_flow_rad = med_rep_flow_deg * pi / 180 ;
    attr_flow_deg = attr_ang_rad * 180 / pi ;

    med_rep_flow_u = cos(med_rep_flow_rad ) ;
    med_rep_flow_v = sin(med_rep_flow_rad ) ;

    % subgoal ROI
    roi_x = sg - 5


    rx = map_size_px / 2 ;
    ry = rx ;

    %% === Step 6: Downsample the force field for plotting ===
    
    arrow_step = 1; arrow_scale = 20;
    % [X, Y] = meshgrid(1:arrow_step:map_size, 1:arrow_step:map_size) ;
    % Uq = Frx(1:arrow_step:end, 1:arrow_step:end);
    % Vq = Fry(1:arrow_step:end, 1:arrow_step:end); % Flip vertical for image coords
    % 
    % % Scale arrows for visualization
    % Uq(ukn_idx) = 0; 
    % Vq(ukn_idx) = 0 ;
    % Uq = Uq * arrow_scale;
    % Vq = Vq * arrow_scale;
    %quiver(X, Y, Uq, Vq, 0, 'r', 'LineWidth', 1.0); % Draw force vectors

    %% === Step 7: Visualize the Potential Field and Force Vectors ===
    % figure(3); clf;
    % imagesc(angle_map_roi); colorbar ;

    figure(4); clf;
    t = tiledlayout(1, 2, 'TileSpacing', 'compact', 'Padding', 'compact');
    nexttile(t, 1);
    imshow(rgb_img) ;

    nexttile(t, 2);
    imagesc( costmap_i8 );  % Show potential field as a heatmap
    colormap('gray')
    hold on;
    
    plot( rx + waypt_traj_px(:,1) * 100 , ry + waypt_traj_px(:,2) * 100, 'gs') ;
    plot( rx + sg_px(1)*2, rx + sg_px(2)*2,  'ms', 'MarkerSize',12 , 'MarkerFaceColor', 'm') ;
    if (joy_on)
        rectangle('position', [rx - roi_back_px, ry - roi_front_px / 2, roi_front_px, roi_front_px], 'EdgeColor', [1,0,1] ) ;
        plot( rx, ry, 'c.', 'MarkerSize', 48 ) ;
    else
        rectangle('position', [rx - roi_back_px, ry - roi_front_px / 2, roi_front_px, roi_front_px], 'EdgeColor', [0,1,1] ) ;
        plot( rx, ry, 'r.', 'MarkerSize', 48 ) ;
    end

    %quiver( rx, ry, 2, 0, 0, 'b', 'LineWidth', 4) ;
    %imshow(costmap_u8) ;
    %set(gca, 'YDir', 'normal'); 
    colorbar; 
    title('Repulsive Potential Field Vectors');
    hold on;
    
    %h1 = quiver( rx, ry, tgt_wx_px * arrow_scale *5, tgt_wy_px * arrow_scale*5, 'g') ;
    %set(h1, 'AutoScale', 'on', 'AutoScaleFactor', 1, 'LineWidth',2, 'MaxHeadSize', 12) ;

    h2 = quiver( rx+5, ry, med_rep_flow_u * arrow_scale, med_rep_flow_v * arrow_scale, 'r') ;
    set(h2, 'AutoScale', 'on', 'AutoScaleFactor', 1, 'LineWidth',2, 'MaxHeadSize', 12) ;
    
    pause

end